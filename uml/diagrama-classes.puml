@startuml diagrama-classes
' Diagrama de classes do Grafitall (fonte em PlantUML).
' Notação: "-" = private, "+" = public, "#" = protected, sublinhado = static,
' itálico = abstrato. Seta com triângulo vazado (<|--) = herança (extends).
' Seta tracejada com ponta aberta (..>) = "usa" (dependência).

title Grafitall - Diagrama de Classes
!theme plain
skinparam dpi 130
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 90
skinparam ArrowColor #555555
skinparam ArrowThickness 1.2
skinparam TitleFontSize 20
skinparam TitleFontStyle bold
skinparam class {
  BorderThickness 1.2
  FontStyle bold
  BackgroundColor #FFF8E7
  HeaderBackgroundColor #3A3A3A
  BorderColor #3A3A3A
  FontColor #FFFFFF
}
skinparam class<<Base>> {
  BackgroundColor #FFF3C4
  HeaderBackgroundColor #C9A400
  BorderColor #C9A400
  FontColor #222222
}
skinparam class<<DAO>> {
  BackgroundColor #EEF0FB
  HeaderBackgroundColor #4C51A8
  BorderColor #4C51A8
}
skinparam class<<Json>> {
  BackgroundColor #EAF6EF
  HeaderBackgroundColor #2F7A4F
  BorderColor #2F7A4F
}
skinparam package {
  BorderColor #9AA5B1
  FontColor #3C4A5E
}
hide circle
hide stereotype
hide empty members

package grafitall {

  abstract class Cadastro <<Base>> {
    # id: int
    + Cadastro()
    + Cadastro(id: int)
    + getId(): int
    + setId(id: int): void
    + {abstract} getDescricao(): String
  }

  class MateriaPrima {
    - nome: String
    - quantidadeEstoqueKg: Double
    - fornecedor: String
    - precoPorKg: Double
    + MateriaPrima()
    + MateriaPrima(id, nome, quantidadeEstoqueKg, fornecedor, precoPorKg)
    + getters e setters()
    + getDescricao(): String
    + toString(): String
  }

  class LoteProducao {
    - graduacao: String
    - quantidadeProduzidaUnidades: Integer
    - dataFabricacao: String
    - status: String
    + {static} GRADUACOES: String[]
    + {static} STATUS: String[]
    + LoteProducao()
    + LoteProducao(id, graduacao, quantidadeProduzidaUnidades, dataFabricacao, status)
    + getters e setters()
    + getDescricao(): String
    + toString(): String
  }

  class Cliente {
    - razaoSocial: String
    - cnpj: String
    - telefone: String
    - cidadeUf: String
    + Cliente()
    + Cliente(id, razaoSocial, cnpj, telefone, cidadeUf)
    + getters e setters()
    + getDescricao(): String
    + toString(): String
  }

  class MateriaPrimaDAO <<DAO>> {
    - caminho: String
    - tipoLista: Type
    + MateriaPrimaDAO(caminho: String)
    + listar(): ArrayList<MateriaPrima>
    + buscarPorId(id: int): MateriaPrima
    + incluir(novo: MateriaPrima): void
    + alterar(alterado: MateriaPrima): void
    + excluir(id: int): void
  }

  class LoteProducaoDAO <<DAO>> {
    - caminho: String
    - tipoLista: Type
    + LoteProducaoDAO(caminho: String)
    + listar(): ArrayList<LoteProducao>
    + buscarPorId(id: int): LoteProducao
    + incluir(novo: LoteProducao): void
    + alterar(alterado: LoteProducao): void
    + excluir(id: int): void
  }

  class ClienteDAO <<DAO>> {
    - caminho: String
    - tipoLista: Type
    + ClienteDAO(caminho: String)
    + listar(): ArrayList<Cliente>
    + buscarPorId(id: int): Cliente
    + incluir(novo: Cliente): void
    + alterar(alterado: Cliente): void
    + excluir(id: int): void
  }

  class ArquivoJson <<Json>> {
    - {static} gson: Gson
    + {static} ler(caminho: String, tipo: Type): ArrayList<T>
    + {static} gravar(caminho: String, lista: ArrayList<T>): void
  }
}

Cadastro <|-- MateriaPrima
Cadastro <|-- LoteProducao
Cadastro <|-- Cliente

MateriaPrima <.. MateriaPrimaDAO : usa
LoteProducao <.. LoteProducaoDAO : usa
Cliente <.. ClienteDAO : usa

MateriaPrimaDAO ..> ArquivoJson
LoteProducaoDAO ..> ArquivoJson
ClienteDAO ..> ArquivoJson

note bottom of ArquivoJson
  Única classe que mexe nos arquivos .json,
  usando a biblioteca Gson (toJson / fromJson).
end note

@enduml
